# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- Laptop only ---
# The named AWS profile holding the kalysdev keys (see CLAUDE.md, AWS setup).
# Do NOT set this on an EC2 server: there the instance's IAM role supplies
# credentials, and pointing boto3 at a profile that does not exist there
# makes every Bedrock call fail.
AWS_PROFILE=kalys

# --- Both laptop and server ---
AWS_REGION=us-east-1

# Optional overrides; the defaults in the code are fine.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# DATABASE_URL=postgresql://kalys:kalys@localhost:5432/kalys

# Only needed if you ever switch translation to a paid API. Normally empty:
# the one-time translation backlog was done by hand (see LEARNING.md, Step 5).
# GEMINI_API_KEY=
